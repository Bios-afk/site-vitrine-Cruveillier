---
import BaseLayout from "../layout/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.jsx";
import ContentSection from "../components/sections/ContentSection.jsx";
import CtaBand from "../components/sections/CtaBand.jsx";
import stories from "../components/data/stories.json";

export const prerender = true;
---

<BaseLayout
  title={stories.meta.title}
  description={stories.meta.description}
  themeColor={stories.meta.themeColor}
>
  <PageHero data={stories.hero} client:load />
  <ContentSection data={stories.section} items={stories.stories} client:visible />
  <CtaBand data={stories.cta} client:visible />
</BaseLayout>
