---
import BaseLayout from "../layout/BaseLayout.astro";
import ProsePage from "../components/sections/ProsePage.jsx";
import privacy from "../components/data/privacy.json";

export const prerender = true;
---

<BaseLayout
  title={privacy.meta.title}
  description={privacy.meta.description}
  themeColor={privacy.meta.themeColor}
>
  <ProsePage data={privacy.page} client:load />
</BaseLayout>
