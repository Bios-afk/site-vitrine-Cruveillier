---
import BaseLayout from "../layout/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.jsx";
import FeatureGrid from "../components/sections/FeatureGrid.jsx";
import CtaBand from "../components/sections/CtaBand.jsx";
import about from "../components/data/about.json";

export const prerender = true;
---

<BaseLayout
  title={about.meta.title}
  description={about.meta.description}
  themeColor={about.meta.themeColor}
>
  <PageHero data={about.hero} client:load />
  <FeatureGrid data={about.values} items={about.valueItems} client:visible />
  <CtaBand data={about.cta} client:visible />
</BaseLayout>
