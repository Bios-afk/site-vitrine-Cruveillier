---
import BaseLayout from "../layout/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.jsx";
import FeatureGrid from "../components/sections/FeatureGrid.jsx";
import ContactForm from "../components/sections/ContactForm.jsx";
import data from "../components/data/get-started.json";

export const prerender = true;
---

<BaseLayout
  title={data.meta.title}
  description={data.meta.description}
  themeColor={data.meta.themeColor}
>
  <PageHero data={data.hero} client:load />
  <FeatureGrid data={data.benefits} items={data.benefitItems} client:visible />
  <ContactForm data={data.form} client:visible />
</BaseLayout>
