---
import BaseLayout from "../layout/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.jsx";
import SearchPage from "../components/sections/SearchPage.jsx";
import search from "../components/data/search.json";

export const prerender = true;
---

<BaseLayout
  title={search.meta.title}
  description={search.meta.description}
  themeColor={search.meta.themeColor}
>
  <PageHero data={search.hero} client:load />
  <SearchPage data={search} client:load />
</BaseLayout>
