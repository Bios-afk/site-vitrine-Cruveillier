---
import BaseLayout from "../../layout/BaseLayout.astro";
import PageHero from "../../components/sections/PageHero.jsx";
import ContentSection from "../../components/sections/ContentSection.jsx";
import CtaBand from "../../components/sections/CtaBand.jsx";
import shows from "../../components/data/shows.json";

export const prerender = true;
---

<BaseLayout
  title={shows.meta.title}
  description={shows.meta.description}
  themeColor={shows.meta.themeColor}
>
  <PageHero data={shows.hero} client:load />
  <ContentSection data={shows.section} items={shows.shows} client:visible />
  <CtaBand data={shows.cta} client:visible />
</BaseLayout>
