---
import BaseLayout from "../../layout/BaseLayout.astro";
import MediaDetail from "../../components/sections/MediaDetail.jsx";
import CtaBand from "../../components/sections/CtaBand.jsx";
import details from "../../components/data/details.json";
import podcast from "../../components/data/podcast.json";

export const prerender = true;

export function getStaticPaths() {
  return Object.entries(details.podcast).map(([slug, item]) => ({
    params: { slug },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<BaseLayout
  title={item.title}
  description={item.excerpt}
  themeColor={podcast.meta.themeColor}
  type="article"
  image={typeof item.media === "string" && !item.media.endsWith(".mp4")
    ? item.media
    : undefined}
>
  <MediaDetail item={item} client:load />
  <CtaBand data={podcast.cta} client:visible />
</BaseLayout>
