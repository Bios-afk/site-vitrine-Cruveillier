---
import BaseLayout from "../../layout/BaseLayout.astro";
import PageHero from "../../components/sections/PageHero.jsx";
import ContentSection from "../../components/sections/ContentSection.jsx";
import CtaBand from "../../components/sections/CtaBand.jsx";
import podcast from "../../components/data/podcast.json";

export const prerender = true;
---

<BaseLayout
  title={podcast.meta.title}
  description={podcast.meta.description}
  themeColor={podcast.meta.themeColor}
>
  <PageHero data={podcast.hero} client:load />
  <ContentSection data={podcast.section} items={podcast.episodes} client:visible />
  <CtaBand data={podcast.cta} client:visible />
</BaseLayout>
