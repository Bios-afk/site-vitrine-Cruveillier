---
import BaseLayout from "../layout/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.jsx";
import ContactForm from "../components/sections/ContactForm.jsx";
import FeatureGrid from "../components/sections/FeatureGrid.jsx";
import contact from "../components/data/contact.json";

export const prerender = true;
---

<BaseLayout
  title={contact.meta.title}
  description={contact.meta.description}
  themeColor={contact.meta.themeColor}
>
  <PageHero data={contact.hero} client:load />
  <ContactForm data={contact.form} client:visible />
  <FeatureGrid data={contact.channels} items={contact.channelItems} client:visible />
</BaseLayout>
