---
import BaseLayout from "../layout/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.jsx";
import FeatureGrid from "../components/sections/FeatureGrid.jsx";
import CtaBand from "../components/sections/CtaBand.jsx";
import support from "../components/data/support.json";

export const prerender = true;
---

<BaseLayout
  title={support.meta.title}
  description={support.meta.description}
  themeColor={support.meta.themeColor}
>
  <PageHero data={support.hero} client:load />
  <FeatureGrid data={support.topics} items={support.topicItems} client:visible />
  <CtaBand data={support.cta} client:visible />
</BaseLayout>
